[layer_names]

3d_physics/layer_1="Static_World"
3d_physics/layer_2="Player_Body"
3d_physics/layer_3="Interactables"
3d_physics/layer_4="Monsters"
3d_physics/layer_5="Sensory_Triggers"

3d_render/layer_1="World_Default"
3d_render/layer_2="Sanity_Hallucinations"
3d_render/layer_3="Foliage_Grass"
3d_render/layer_4="Interaction_Highlights"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
global_illumination/sdfgi/enabled=true
global_illumination/ssil/enabled=true
environment/volumetric_fog/use_filter=true
