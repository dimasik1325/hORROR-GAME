; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also easily readable and manageable.

config_version=5

[application]

config/name="Эхо Чащи (Echo of the Thicket)"
config/description="Next-Gen 3D Psychological Horror in Deep Taiga Forest powered by Godot 4.6"
run/main_scene="res://scenes/MainWorld.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

SanityGlobalManager="*res://scripts/managers/SanityGlobalManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/vsync/vsync_mode=1

