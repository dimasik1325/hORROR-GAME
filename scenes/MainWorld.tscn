[node name="Note_CabinPorch" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.2, 0.35, -19.2)
note_title = "Записка #1: Письмо на Кордоне"
full_text = "«Детективу Уэйну. Если ты читаешь это — ты уже в ловушке Черного Омута. Экспедиция ушла к болоту. Не верь своим глазам: деревья наблюдают за тобой, а в рации звучит твой собственный голос...»"
author_signature = "Анонимный Заказчик"
note_index = 1

[node name="Note_SwampJeep" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(0.866025, 0, 0.5, 0, 1, 0, -0.5, 0, 0.866025, -18.5, 0.85, -41.2)
note_title = "Записка #2: Дневник у Джипа"
full_text = "«17 сентября. Машина застряла в трясине. Они окружили нас. Это не звери — это сплетения корней и мертвецов. Наш командир перед смертью повторял: 'Уэйн вернется, чтобы завершить ритуал'... О ком он говорил?!»"
author_signature = "Геодезист Смирнов"
note_index = 2

[node name="Note_Sawmill" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(0.866025, 0, -0.5, 0, 1, 0, 0.5, 0, 0.866025, 33.2, 0.65, -11.0)
note_title = "Записка #3: Ритуальный Манифест"
full_text = "«Великое Сдирание Коры неизбежно. Лидер культа сотрет свой разум и вернется как невинная жертва. Когда четыре осколка памяти соединятся на Алтаре под Древом — Тайга поглотит весь мир...»"
author_signature = "Адепты Первородной Коры"
note_index = 3

[node name="Note_TitanAltar" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30.0, 1.15, -48.0)
note_title = "Записка #4: Почерк Уэйна"
full_text = "«Боже мой... Это мой собственный почерк. Письма, которые привели меня сюда, написал я сам. Я сам отдал приказ геодезистам принести себя в жертву. Я — Нулевой Пациент и Верховный Жрец. Я сам стер себе память...»"
author_signature = "Детектив Уэйн"
note_index = 4

