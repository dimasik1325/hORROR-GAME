[node name="Note_CabinPorch" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.2, 0.35, -19.2)
note_title = "Записка #1: Письмо на кордоне"
full_text = "«Детективу Уэйну. Если ты добрался до Черного Омута — значит, экспедиция уже у них. Не верь собственным глазам. Лес помнит твои грехи...»"
author_signature = "Аноним"
note_index = 1

[node name="Note_Campfire" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(0.866025, 0, 0.5, 0, 1, 0, -0.5, 0, 0.866025, 1.5, 0.15, -7.5)
note_title = "Записка #2: Дневник геодезиста"
full_text = "«Они приходят из тумана. Мы заперлись в избушке, но корни начали прорастать прямо сквозь половицы. Наш командир пошел в чащу и шептал имя Уэйна...»"
author_signature = "Геодезист Смирнов"
note_index = 2

[node name="Note_Lantern" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.2, 0.15, -14.8)
note_title = "Записка #3: Ритуальный манифест"
full_text = "«Сдирание Коры неизбежно. Тот, кто сотрет свой разум, станет новым семенем Древа. Цикл Уробороса не разомкнется...»"
author_signature = "Адепты Первородной Коры"
note_index = 3

[node name="Note_CultistAltar" parent="Interactables" instance=ExtResource("12_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 14.5, 0.2, -24.0)
note_title = "Записка #4: Почерк Уэйна"
full_text = "«Это мой собственный почерк. Я сам отдал приказ принести их в жертву. Я сам стер себе память. Я и есть Лидер культа...»"
author_signature = "Детектив Уэйн"
note_index = 4

